# Copia este archivo como .env y cambia los valores.
# .env NO se sube al repositorio. Estos valores son de ejemplo, no secretos reales:
# si no existe .env, el servicio arranca con ellos.
DATABASE_URL=sqlite:///app.db
SECRETO_FIRMA=cambia-este-secreto-de-firma
CLAVE_API_REASEGURO=cambia-esta-clave-de-reaseguro
RUTA_MODELO=modelo.pkl
UMBRAL_ALTO_RIESGO=0.6
